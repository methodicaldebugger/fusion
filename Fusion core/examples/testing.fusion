//! Run with:  fusion test examples/testing.fusion
//! Benchmarks: fusion bench examples/testing.fusion

fn double(x: num) -> num:
    return x * 2

#[test]
fn doubles_numbers():
    assert_eq(double(21), 42)

#[test]
fn sha256_matches_the_standard_vector():
    assert_eq(sha256("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")

#[test]
#[should_panic]
fn assertions_fail_loudly():
    assert_eq(double(1), 3)

#[test]
#[ignore]
fn needs_the_network():
    http_get("http://127.0.0.1:1/")

#[bench]
fn bench_double():
    x = double(21)

main:
    print(double(4))
